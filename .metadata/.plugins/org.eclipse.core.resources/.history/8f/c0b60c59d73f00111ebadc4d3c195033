    }

    printf("Introdu numele: ");
    fflush(stdout);
    scanf("%49s", nume_cautat);
    printf("Introdu prenumele: ");
    fflush(stdout);
    scanf("%49s", prenume_cautat);

    printf("\nRezultate cautare:\n");
