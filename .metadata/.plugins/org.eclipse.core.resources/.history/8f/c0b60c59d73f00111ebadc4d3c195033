                studenti[i].prenume,
                studenti[i].an_studiu,
                studenti[i].grupa,
                studenti[i].email
            );
            gasit = 1;
        }
    }

    if (!gasit) {
        printf("Nu exista student cu acest nume si prenume.\n");
    }
}

void deschide_mod_grafic_student(void) {
    int cod,optiune;
    int i,j,nr_selectati;
    DateStudent *student;
    int coduri_selectati[5];
    char fisier_rel[220];
    char fisier_rel_alt[220];
    char fisier_abs_alt[700];
    int selectie[5];
    int arata_men;
    
#ifdef _WIN32
    char base_dir[MAX_PATH];
    char workspace_dir[MAX_PATH];
    char data_dir[MAX_PATH];

    char exe_grafic[MAX_PATH];
    char fisier_abs[700];
    char argumente[3000];
    char comanda[4096];
    size_t used;
    int written;
    int cod_system;

    obtine_cale_executabil(base_dir, sizeof(base_dir));
    obtine_cale_date_studenti(data_dir, sizeof(data_dir));

    strncpy(workspace_dir, base_dir, sizeof(workspace_dir) - 1);
    workspace_dir[sizeof(workspace_dir) - 1] = '\0';
    {
        char *ultim_sep = strrchr(workspace_dir, '\\');
        if (ultim_sep != NULL) {
            *ultim_sep = '\0';
        }
    }

    snprintf(exe_grafic, sizeof(exe_grafic), "%s\\medii_opengl\\Debug\\medii_opengl.exe", workspace_dir);

    if (GetFileAttributesA(exe_grafic) == INVALID_FILE_ATTRIBUTES) {
        printf("Nu exista executabilul grafic: %s\n", exe_grafic);
        return;
    }

    /* Construiește argumentele cu căile ABSOLUTE către fișierele text */
    argumente[0] = '\0';
    for (i = 0; i < nr_selectati; i++) {
        student = cauta_student_dupa_cod(coduri_selectati[i]);
        if (student != NULL) {
            snprintf(
                fisier_rel,
                sizeof(fisier_rel),
                "an_%d\\grupa_%d\\%d_%s_%s.txt",
                student->an_studiu,
                student->grupa,
                student->cod_personal,
                student->nume,
                student->prenume
            );
            
            /* Construim calea absoluta unind data_dir cu folderul an_X\grupa_Y */
            snprintf(fisier_abs, sizeof(fisier_abs), "%s\\%s", data_dir, fisier_rel);
            
            if (GetFileAttributesA(fisier_abs) == INVALID_FILE_ATTRIBUTES) {
                snprintf(
                    fisier_rel_alt,
                    sizeof(fisier_rel_alt),
                    "an_%d\\grupa_%d\\%d_%s_%s.txt",
                    student->an_studiu,
                    student->grupa,
                    student->cod_personal,
                    student->prenume,
                    student->nume
                );
                snprintf(fisier_abs_alt, sizeof(fisier_abs_alt), "%s\\%s", data_dir, fisier_rel_alt);

                if (GetFileAttributesA(fisier_abs_alt) == INVALID_FILE_ATTRIBUTES) {
                    printf("Nu exista fisierul studentului: %s sau %s\n", fisier_abs, fisier_abs_alt);
                    return;
                }

                strncpy(fisier_abs, fisier_abs_alt, sizeof(fisier_abs) - 1);
                fisier_abs[sizeof(fisier_abs) - 1] = '\0';
            }
            
            /* Adaugă fișierul la string-ul de argumente: "cale1" "cale2" */
            used = strlen(argumente);
            written = snprintf(
                argumente + used,
                sizeof(argumente) - used,
                "%s\"%s\"",
                (i > 0) ? " " : "",
                fisier_abs
            );
            if (written < 0 || (size_t)written >= sizeof(argumente) - used) {
                printf("Lista de fisiere pentru modul grafic este prea lunga.\n");
                return;
            }
        }
    }

    printf("\nLansez modul grafic cu %d student(i)...\n", nr_selectati);
    snprintf(comanda, sizeof(comanda), "\"%s\" %s", exe_grafic, argumente);
    cod_system = system(comanda);
    if (cod_system != 0) {
        printf("Nu am putut lansa modulul grafic prin system() (cod=%d).\n", cod_system);
    }

#else
    (void)fisier_rel;
    printf("Lansarea modulului grafic este implementata doar pentru Windows in aceasta versiune.\n");
#endif
}
