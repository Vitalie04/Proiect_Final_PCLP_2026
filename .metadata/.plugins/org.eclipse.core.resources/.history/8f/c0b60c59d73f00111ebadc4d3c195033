void obtine_cale_executabil(char *buffer, size_t dim_buffer) {
    char *ultim_sep;

    if (buffer == NULL || dim_buffer == 0) {
        return;
    }

#ifdef _WIN32
    if (GetModuleFileNameA(NULL, buffer, (DWORD)dim_buffer) == 0) {
        strncpy(buffer, ".", dim_buffer - 1);
        buffer[dim_buffer - 1] = '\0';
        return;
    }
    buffer[dim_buffer - 1] = '\0';
    ultim_sep = strrchr(buffer, '\\');
    if (ultim_sep != NULL) {
        *ultim_sep = '\0';
    }
#else
    (void)ultim_sep;
    strncpy(buffer, ".", dim_buffer - 1);
    buffer[dim_buffer - 1] = '\0';
#endif
}

void obtine_cale_date_studenti(char *buffer, size_t dim_buffer) {
    char dir_executabil[512];
    char *ultim_sep;
    int scris;

    if (buffer == NULL || dim_buffer == 0) {
        return;
    }

#ifdef _WIN32
    obtine_cale_executabil(dir_executabil, sizeof(dir_executabil));
    ultim_sep = strrchr(dir_executabil, '\\');
    if (ultim_sep != NULL) {
        *ultim_sep = '\0';
    }
    scris = snprintf(buffer, dim_buffer, "%s\\StudentData", dir_executabil);
    if (scris < 0 || (size_t)scris >= dim_buffer) {
        buffer[dim_buffer - 1] = '\0';
    }
#else
    (void)dir_executabil;
    (void)ultim_sep;
    strncpy(buffer, "StudentData", dim_buffer - 1);
    buffer[dim_buffer - 1] = '\0';
#endif
}

void construieste_email(const char *prenume, const char *nume, char *email, size_t dim_email) {
    char prenume_mic[50];
    char nume_mic[50];
    size_t i;
    char ch;

    for (i = 0; i < sizeof(prenume_mic) - 1 && prenume[i] != '\0'; i++) {
        ch = prenume[i];
        if (ch >= 'A' && ch <= 'Z') {
            ch = (char)(ch + ('a' - 'A'));
        }
        prenume_mic[i] = ch;
    }
    prenume_mic[i] = '\0';

    for (i = 0; i < sizeof(nume_mic) - 1 && nume[i] != '\0'; i++) {
        ch = nume[i];
        if (ch >= 'A' && ch <= 'Z') {
            ch = (char)(ch + ('a' - 'A'));
        }
        nume_mic[i] = ch;
    }
    nume_mic[i] = '\0';

    snprintf(email, dim_email, "%s.%s@student.tuiasi.ro", prenume_mic, nume_mic);
}

int egal_ignore_case(const char *a, const char *b) {
    while (*a != '\0' && *b != '\0') {
        if (tolower((unsigned char)*a) != tolower((unsigned char)*b)) {
            return 0;
        }
        a++;
        b++;
    }
    return *a == '\0' && *b == '\0';
}

void initializare_situatie(SituatieStudent *s) {
    s->semestre = 0;
    s->discipline = 0;
    s->note = NULL;
    s->credite = NULL;
    s->medii_ponderate = NULL;
    s->credite_semestru = NULL;
    s->nr_discipline_peste_4_credite = 0;
    s->nr_restante_absente = 0;
    s->nr_semestre_scadere = 0;
    s->semestre_scadere = NULL;
}

void elibereaza_situatie(SituatieStudent *s) {
    int i;
    if (s->note != NULL) {
        for (i = 0; i < s->semestre; i++) {
            free(s->note[i]);
        }
        free(s->note);
    }
    if (s->credite != NULL) {
        for (i = 0; i < s->semestre; i++) {
            free(s->credite[i]);
        }
        free(s->credite);
    }
    free(s->medii_ponderate);
    free(s->credite_semestru);
    free(s->semestre_scadere);
    initializare_situatie(s);
}

void elibereaza_toata_memoria(void) {
    int i;
    for (i = 0; i < nr_studenti; i++) {
        elibereaza_situatie(&studenti[i].situatie);
    }
    free(studenti);
    studenti = NULL;
    nr_studenti = 0;
    capacitate_studenti = 0;
}

int asigura_capacitate_studenti(void) {
    DateStudent *nou_vector;
    int capacitate_noua;
    if (nr_studenti < capacitate_studenti) {
        return 1;
    }
    capacitate_noua = (capacitate_studenti == 0) ? 4 : capacitate_studenti * 2;
    nou_vector = (DateStudent *)realloc(studenti, (size_t)capacitate_noua * sizeof(DateStudent));
    if (nou_vector == NULL) {
        printf("Eroare: nu s-a putut realoca memorie pentru studenti.\n");
        return 0;
    }
    studenti = nou_vector;
    capacitate_studenti = capacitate_noua;
    return 1;
}

int creeaza_director_daca_lipseste(const char *cale) {
    if (MKDIR(cale) == 0) {
        return 1;
    }
    if (errno == EEXIST) {
        return 1;
    }
    return 0;
}

void alege_an_si_grupa(int *an_studiu, int *grupa) {
    int an, g;
    do {
        printf("Alege anul de studiu (1-4): ");
        fflush(stdout);
        scanf("%d", &an);
    } while (an < 1 || an > 4);

    do {
        printf("Alege grupa (1-15): ");
        fflush(stdout);
        scanf("%d", &g);
    } while (g < 1 || g > 15);

    *an_studiu = an;
    *grupa = g;
}

void scrie_fisa_student(DateStudent *student) {
    char director_baza[512];
    char director_an[512];
    char director_grupa[512];
    char fisier[700];
    FILE *f;
    int sem, d;
    int restante_sem;
    int idx_restanta;
    int suma_credite;
    int suma_produs;
    int credit_rest;
    int punctaj_rest;
    int credite_fara;
    double medie_fara_restanta;
    SituatieStudent *s = &student->situatie;

    obtine_cale_date_studenti(director_baza, sizeof(director_baza));
    snprintf(director_an, sizeof(director_an), "%s\\an_%d", director_baza, student->an_studiu);
    snprintf(director_grupa, sizeof(director_grupa), "%s\\grupa_%d", director_an, student->grupa);
    if (!creeaza_director_daca_lipseste(director_baza) ||
        !creeaza_director_daca_lipseste(director_an) ||
        !creeaza_director_daca_lipseste(director_grupa)) {
        printf("Avertisment: nu am putut crea directoarele pentru fisierul studentului.\n");
        return;
    }

    snprintf(
        fisier,
        sizeof(fisier),
        "%s\\%d_%s_%s.txt",
        director_grupa,
        student->cod_personal,
        student->nume,
        student->prenume
    );

    f = fopen(fisier, "w");
    if (f == NULL) {
        printf("Avertisment: nu am putut deschide fisierul pentru student.\n");
        return;
    }

    fprintf(f, "=== Fisa student ===\n");
    fprintf(f, "Cod personal: %d\n", student->cod_personal);
    fprintf(f, "Nume: %s\n", student->nume);
    fprintf(f, "Prenume: %s\n", student->prenume);
    fprintf(f, "Varsta: %d\n", student->varsta);
    fprintf(f, "An studiu: %d\n", student->an_studiu);
    fprintf(f, "Grupa: %d\n", student->grupa);
    fprintf(f, "Email: %s\n", student->email);
    fprintf(f, "Bonus media: %.2f\n", student->bonus_media);

    if (s->semestre > 0 && s->discipline > 0 && s->note != NULL && s->credite != NULL) {
        calculeaza_indicatori_scolari(s);
        fprintf(f, "\n=== Situatie scolara ===\n");
        for (sem = 0; sem < s->semestre; sem++) {
            fprintf(
                f,
                "Semestrul %d -> Credite: %d | Medie ponderata: %.2f\n",
                sem + 1,
                s->credite_semestru[sem],
                s->medii_ponderate[sem]
            );
        }

        fprintf(f, "Discipline cu peste 4 credite: %d\n", s->nr_discipline_peste_4_credite);
        fprintf(f, "Discipline picate sau absente: %d\n", s->nr_restante_absente);

        if (s->nr_semestre_scadere == 0) {
            fprintf(f, "Semestre cu scadere: niciunul\n");
        } else {
            fprintf(f, "Semestre cu scadere: ");
            for (sem = 0; sem < s->nr_semestre_scadere; sem++) {
                fprintf(f, "%d ", s->semestre_scadere[sem]);
            }
            fprintf(f, "\n");
        }

        for (sem = 0; sem < s->semestre; sem++) {
            restante_sem = 0;
            idx_restanta = -1;
            suma_credite = 0;
            suma_produs = 0;

            for (d = 0; d < s->discipline; d++) {
                if (s->note[sem][d] == -1 || s->credite[sem][d] == -1) {
                    continue;
                }
                suma_credite += s->credite[sem][d];
                suma_produs += s->note[sem][d] * s->credite[sem][d];
                if (s->note[sem][d] >= 0 && s->note[sem][d] < 5) {
                    restante_sem++;
                    idx_restanta = d;
                }
            }

            if (restante_sem == 1 && idx_restanta >= 0) {
                credit_rest = s->credite[sem][idx_restanta];
                punctaj_rest = s->note[sem][idx_restanta] * credit_rest;
                credite_fara = suma_credite - credit_rest;
                medie_fara_restanta =
                    (credite_fara > 0) ? (double)(suma_produs - punctaj_rest) / (double)credite_fara : 0.0;

                fprintf(
                    f,
                    "Semestrul %d are exact o restanta/absenta. Medie curenta %.2f, medie fara disciplina %.2f\n",
                    sem + 1,
                    s->medii_ponderate[sem],
                    medie_fara_restanta
                );
            }
        }

        fprintf(f, "\n=== Detalii discipline ===\n");
        for (sem = 0; sem < s->semestre; sem++) {
            for (d = 0; d < s->discipline; d++) {
                fprintf(
                    f,
                    "Semestrul %d, Disciplina %d: Nota=%d Credite=%d\n",
                    sem + 1,
                    d + 1,
                    s->note[sem][d],
                    s->credite[sem][d]
                );
            }
        }
    }

    fclose(f);
}

void adaugare_studenti(void) {
    int continua = 1;
    int incepe;
    DateStudent *student;

    while (continua == 1) {
        printf("\n=== Adaugare student nou ===\n");
        printf("Continui adaugarea? (1=Da, 0=Cancel): ");
        fflush(stdout);
        scanf("%d", &incepe);

        if (incepe == 0) {
            printf("Adaugarea a fost anulata. Revenire la meniul principal.\n");
    fflush(stdout);
            break;
        }
        if (incepe != 1) {
            printf("Optiune invalida. Incearca din nou.\n");
            continue;
        }

        if (!asigura_capacitate_studenti()) {
            return;
        }

        student = &studenti[nr_studenti];
        initializare_situatie(&student->situatie);
        student->bonus_media = 0.0;

        printf("Nume (0=Cancel): ");
        scanf("%49s", student->nume);
        if (strcmp(student->nume, "0") == 0) {
            printf("Adaugarea a fost anulata. Revenire la meniul principal.\n");
            break;
        }

        printf("Prenume (0=Cancel): ");
    fflush(stdout);
        scanf("%49s", student->prenume);
        if (strcmp(student->prenume, "0") == 0) {
            printf("Adaugarea a fost anulata. Revenire la meniul principal.\n");
            break;
        }

        printf("Varsta (0=Cancel): ");
    fflush(stdout);
        scanf("%d", &student->varsta);
        if (student->varsta == 0) {
            printf("Adaugarea a fost anulata. Revenire la meniul principal.\n");
            break;
        }

        student->cod_personal = urmator_cod_personal++;
        construieste_email(student->prenume, student->nume, student->email, sizeof(student->email));

        alege_an_si_grupa(&student->an_studiu, &student->grupa);
        scrie_fisa_student(student);

        nr_studenti++;
        printf("Student adaugat cu succes. Cod personal: %d\n", student->cod_personal);
        printf("Email generat: %s\n", student->email);

        printf("Mai doresti sa adaugi alt student? (1=Da, 0=Nu): ");
        fflush(stdout);
        scanf("%d", &continua);
    }
}

