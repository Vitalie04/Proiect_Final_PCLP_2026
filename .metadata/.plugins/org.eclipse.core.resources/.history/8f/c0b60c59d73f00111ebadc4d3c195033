int incarca_un_student_din_fisier(const char *cale_fisier) {
    FILE *f;
    char linie[256];
    char *p;
    char *endptr;
    DateStudent student_temp;
    int sem_idx;
    int disc_idx;
    int nota;
    int credit;
    int max_sem;
    int max_disc;
    int i;
    int j;
    int ok_linii;
    int in_detalii;
    int semestre_summary;
    int nr_scadere;
    int cred_sem;
    double medie_sem;
    int tmp_note[MAX_SEM_FIS][MAX_DISC_FIS];
    int tmp_credite_det[MAX_SEM_FIS][MAX_DISC_FIS];
    int tmp_credite_sum[MAX_SEM_FIS];
    double tmp_medii_sum[MAX_SEM_FIS];
    int tmp_scaderi[MAX_SEM_FIS];

    memset(&student_temp, 0, sizeof(student_temp));
    initializare_situatie(&student_temp.situatie);

    for (i = 0; i < MAX_SEM_FIS; i++) {
        tmp_credite_sum[i] = 0;
        tmp_medii_sum[i] = 0.0;
        tmp_scaderi[i] = 0;
        for (j = 0; j < MAX_DISC_FIS; j++) {
            tmp_note[i][j] = -1;
            tmp_credite_det[i][j] = -1;
        }
    }

    max_sem = 0;
    max_disc = 0;
    ok_linii = 0;
    in_detalii = 0;
    semestre_summary = 0;
    nr_scadere = 0;

    f = fopen(cale_fisier, "r");
    if (f == NULL) {
        return 0;
    }

    while (fgets(linie, sizeof(linie), f) != NULL) {
        if (strncmp(linie, "=== Detalii discipline ===", 26) == 0) {
            in_detalii = 1;
            continue;
        }

        if (strncmp(linie, "Cod personal:", 13) == 0) {
            sscanf(linie + 13, "%d", &student_temp.cod_personal);
        } else if (strncmp(linie, "Nume:", 5) == 0) {
            sscanf(linie + 5, "%49s", student_temp.nume);
        } else if (strncmp(linie, "Prenume:", 8) == 0) {
            sscanf(linie + 8, "%49s", student_temp.prenume);
        } else if (strncmp(linie, "Varsta:", 7) == 0) {
            sscanf(linie + 7, "%d", &student_temp.varsta);
        } else if (strncmp(linie, "An studiu:", 10) == 0) {
            sscanf(linie + 10, "%d", &student_temp.an_studiu);
        } else if (strncmp(linie, "Grupa:", 6) == 0) {
            sscanf(linie + 6, "%d", &student_temp.grupa);
        } else if (strncmp(linie, "Email:", 6) == 0) {
            sscanf(linie + 6, "%79s", student_temp.email);
        } else if (strncmp(linie, "Bonus media:", 12) == 0) {
            sscanf(linie + 12, "%lf", &student_temp.bonus_media);
        } else if (strncmp(linie, "Semestrul", 9) == 0 && strstr(linie, "Medie ponderata:") != NULL) {
            sem_idx = 0;
            cred_sem = 0;
            medie_sem = 0.0;
            if (sscanf(linie, "Semestrul %d -> Credite: %d | Medie ponderata: %lf", &sem_idx, &cred_sem, &medie_sem) == 3) {
                if (sem_idx >= 1 && sem_idx <= MAX_SEM_FIS) {
                    tmp_credite_sum[sem_idx - 1] = cred_sem;
                    tmp_medii_sum[sem_idx - 1] = medie_sem;
                    if (sem_idx > semestre_summary) {
                        semestre_summary = sem_idx;
                    }
                }
            }
        } else if (strncmp(linie, "Discipline cu peste 4 credite:", 29) == 0) {
            sscanf(linie + 29, "%d", &student_temp.situatie.nr_discipline_peste_4_credite);
        } else if (strncmp(linie, "Discipline picate sau absente:", 30) == 0) {
            sscanf(linie + 30, "%d", &student_temp.situatie.nr_restante_absente);
        } else if (strncmp(linie, "Semestre cu scadere:", 20) == 0) {
            p = linie + 20;
            while (*p != '\0') {
                while (*p == ' ' || *p == '\t') {
                    p++;
                }
                if (*p == '\0' || *p == '\n') {
                    break;
                }
                if (strncmp(p, "niciunul", 8) == 0) {
                    break;
                }
                sem_idx = (int)strtol(p, &endptr, 10);
                if (endptr == p) {
                    break;
                }
                if (nr_scadere < MAX_SEM_FIS) {
                    tmp_scaderi[nr_scadere] = sem_idx;
                    nr_scadere++;
                }
                p = endptr;
            }
        } else if (in_detalii) {
            sem_idx = 0;
            disc_idx = 0;
            nota = -1;
            credit = -1;
            if (sscanf(linie, "Semestrul %d, Disciplina %d: Nota=%d Credite=%d", &sem_idx, &disc_idx, &nota, &credit) == 4) {
                if (sem_idx >= 1 && sem_idx <= MAX_SEM_FIS && disc_idx >= 1 && disc_idx <= MAX_DISC_FIS) {
                    tmp_note[sem_idx - 1][disc_idx - 1] = nota;
                    tmp_credite_det[sem_idx - 1][disc_idx - 1] = credit;
                    if (sem_idx > max_sem) {
                        max_sem = sem_idx;
                    }
                    if (disc_idx > max_disc) {
                        max_disc = disc_idx;
                    }
                    ok_linii = 1;
                }
            }
        }
    }

    fclose(f);

    if (student_temp.cod_personal <= 0 || student_temp.nume[0] == '\0' || student_temp.prenume[0] == '\0') {
        return 0;
    }

    if (ok_linii && max_sem > 0 && max_disc > 0) {
        student_temp.situatie.semestre = max_sem;
        student_temp.situatie.discipline = max_disc;
        student_temp.situatie.note = (int **)malloc((size_t)max_sem * sizeof(int *));
        student_temp.situatie.credite = (int **)malloc((size_t)max_sem * sizeof(int *));
        if (student_temp.situatie.note == NULL || student_temp.situatie.credite == NULL) {
            elibereaza_situatie(&student_temp.situatie);
            return 0;
        }

        for (i = 0; i < max_sem; i++) {
            student_temp.situatie.note[i] = (int *)malloc((size_t)max_disc * sizeof(int));
            student_temp.situatie.credite[i] = (int *)malloc((size_t)max_disc * sizeof(int));
            if (student_temp.situatie.note[i] == NULL || student_temp.situatie.credite[i] == NULL) {
                elibereaza_situatie(&student_temp.situatie);
                return 0;
            }
            for (j = 0; j < max_disc; j++) {
                student_temp.situatie.note[i][j] = tmp_note[i][j];
                student_temp.situatie.credite[i][j] = tmp_credite_det[i][j];
            }
        }

        calculeaza_indicatori_scolari(&student_temp.situatie);
    } else if (semestre_summary > 0) {
        student_temp.situatie.semestre = semestre_summary;
        student_temp.situatie.discipline = 0;
        student_temp.situatie.medii_ponderate = (double *)calloc((size_t)semestre_summary, sizeof(double));
        student_temp.situatie.credite_semestru = (int *)calloc((size_t)semestre_summary, sizeof(int));
        if (nr_scadere > 0) {
            student_temp.situatie.semestre_scadere = (int *)calloc((size_t)nr_scadere, sizeof(int));
        }

        if (student_temp.situatie.medii_ponderate == NULL || student_temp.situatie.credite_semestru == NULL) {
            elibereaza_situatie(&student_temp.situatie);
            return 0;
        }

        for (i = 0; i < semestre_summary; i++) {
            student_temp.situatie.medii_ponderate[i] = tmp_medii_sum[i];
            student_temp.situatie.credite_semestru[i] = tmp_credite_sum[i];
        }
        student_temp.situatie.nr_semestre_scadere = nr_scadere;
        if (student_temp.situatie.semestre_scadere != NULL) {
            for (i = 0; i < nr_scadere; i++) {
                student_temp.situatie.semestre_scadere[i] = tmp_scaderi[i];
            }
        }
    }

    if (!asigura_capacitate_studenti()) {
        return 0;
    }

    studenti[nr_studenti] = student_temp;
    nr_studenti++;

    if (student_temp.cod_personal >= urmator_cod_personal) {
        urmator_cod_personal = student_temp.cod_personal + 1;
    }

    return 1;
}

int incarca_studenti_din_fisiere(void) {
    int an;
    int grupa;
    int total;

#ifdef _WIN32
    char baza_date[256];
    char pattern[512];
    char cale_fisier[512];
    WIN32_FIND_DATAA data;
    HANDLE hfind;

    obtine_cale_date_studenti(baza_date, sizeof(baza_date));

    total = 0;
    for (an = 1; an <= 4; an++) {
        for (grupa = 1; grupa <= 15; grupa++) {
            snprintf(pattern, sizeof(pattern), "%s\\an_%d\\grupa_%d\\*.txt", baza_date, an, grupa);
            hfind = FindFirstFileA(pattern, &data);
            if (hfind == INVALID_HANDLE_VALUE) {
                continue;
            }

            do {
                if ((data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
                    snprintf(cale_fisier, sizeof(cale_fisier), "%s\\an_%d\\grupa_%d\\%s", baza_date, an, grupa, data.cFileName);
                    if (incarca_un_student_din_fisier(cale_fisier)) {
                        total++;
                    }
                }
            } while (FindNextFileA(hfind, &data));

            FindClose(hfind);
        }
    }

    return total;
#else
    total = 0;
    (void)an;
    (void)grupa;
    return total;
#endif
}

DateStudent *cauta_student_dupa_cod(int cod) {
    int i;
    for (i = 0; i < nr_studenti; i++) {
        if (studenti[i].cod_personal == cod) {
            return &studenti[i];
        }
    }
    return NULL;
}

void calculeaza_indicatori_scolari(SituatieStudent *s) {
    int sem, d;
    int suma_credite;
    int suma_produs;
    int nota;
    int credit;

    if (s->note == NULL || s->credite == NULL || s->semestre <= 0 || s->discipline <= 0) {
        return;
    }

    s->nr_discipline_peste_4_credite = 0;
    s->nr_restante_absente = 0;
    s->nr_semestre_scadere = 0;

    free(s->medii_ponderate);
    free(s->credite_semestru);
    free(s->semestre_scadere);
    s->medii_ponderate = (double *)calloc((size_t)s->semestre, sizeof(double));
    s->credite_semestru = (int *)calloc((size_t)s->semestre, sizeof(int));
    s->semestre_scadere = (int *)calloc((size_t)s->semestre, sizeof(int));

    if (s->medii_ponderate == NULL || s->credite_semestru == NULL || s->semestre_scadere == NULL) {
        printf("Eroare: memorie insuficienta la calculul indicatorilor.\n");
        return;
    }

    for (sem = 0; sem < s->semestre; sem++) {
        suma_credite = 0;
        suma_produs = 0;

        for (d = 0; d < s->discipline; d++) {
            nota = s->note[sem][d];
            credit = s->credite[sem][d];

            if (nota == -1 || credit == -1) {
                continue;
            }
            if (credit > 4) {
                s->nr_discipline_peste_4_credite++;
            }
            if (nota >= 0 && nota < 5) {
                s->nr_restante_absente++;
            }

            suma_credite += credit;
            suma_produs += nota * credit;
        }

        s->credite_semestru[sem] = suma_credite;
        s->medii_ponderate[sem] = (suma_credite > 0) ? (double)suma_produs / (double)suma_credite : 0.0;

        if (sem > 0 && s->medii_ponderate[sem] < s->medii_ponderate[sem - 1]) {
            s->semestre_scadere[s->nr_semestre_scadere++] = sem + 1;
        }
    }
}

void introdu_situatie_pentru_student(void) {
    int cod;
    int sem, d;
    int nota;
    int credit;
    DateStudent *student;
    SituatieStudent *s;

    if (nr_studenti == 0) {
        printf("Nu exista studenti. Adauga mai intai un student.\n");
        return;
    }

    printf("Introdu codul personal al studentului: ");
    scanf("%d", &cod);
    student = cauta_student_dupa_cod(cod);
    if (student == NULL) {
        printf("Student inexistent.\n");
        return;
    }

    s = &student->situatie;
    elibereaza_situatie(s);

    printf("Numar semestre incheiate: ");
    scanf("%d", &s->semestre);
    printf("Numar discipline pe semestru: ");
    scanf("%d", &s->discipline);

    if (s->semestre <= 0 || s->discipline <= 0) {
        printf("Date invalide pentru situatie.\n");
        initializare_situatie(s);
        return;
    }

    s->note = (int **)malloc((size_t)s->semestre * sizeof(int *));
    s->credite = (int **)malloc((size_t)s->semestre * sizeof(int *));
    if (s->note == NULL || s->credite == NULL) {
        printf("Eroare la alocarea matricilor.\n");
        elibereaza_situatie(s);
        return;
    }

    for (sem = 0; sem < s->semestre; sem++) {
        s->note[sem] = (int *)malloc((size_t)s->discipline * sizeof(int));
        s->credite[sem] = (int *)malloc((size_t)s->discipline * sizeof(int));
        if (s->note[sem] == NULL || s->credite[sem] == NULL) {
            printf("Eroare la alocarea liniilor matricii.\n");
            elibereaza_situatie(s);
            return;
        }
    }

    printf("Pentru locurile libere introdu nota -1.\n");
    for (sem = 0; sem < s->semestre; sem++) {
        printf("\nSemestrul %d\n", sem + 1);
        for (d = 0; d < s->discipline; d++) {
            do {
                printf("Nota disciplina %d (0..10 sau -1): ", d + 1);
                scanf("%d", &nota);
            } while (!((nota >= 0 && nota <= 10) || nota == -1));

            if (nota == -1) {
                s->note[sem][d] = -1;
                s->credite[sem][d] = -1;
                continue;
            }

            do {
                printf("Credite disciplina %d (1..30): ", d + 1);
                scanf("%d", &credit);
            } while (credit < 1 || credit > 30);

            s->note[sem][d] = nota;
            s->credite[sem][d] = credit;
        }
    }

    calculeaza_indicatori_scolari(s);
    scrie_fisa_student(student);
    printf("Situatia scolara a fost salvata pentru codul %d.\n", student->cod_personal);
}

void afiseaza_raport_student(void) {
    int cod;
    int sem, d;
    int restante_sem;
    int idx_restanta;
    int suma_credite;
    int suma_produs;
    int credit_rest;
    int punctaj_rest;
    int credite_fara;
    double medie_fara_restanta;
    DateStudent *student;
    SituatieStudent *s;
    int are_date_detaliate;

    if (nr_studenti == 0) {
        printf("Nu exista studenti.\n");
        return;
    }

    printf("Introdu codul personal: ");
    fflush(stdout);
    scanf("%d", &cod);
    student = cauta_student_dupa_cod(cod);
    if (student == NULL) {
        printf("Student inexistent.\n");
        return;
    }

    s = &student->situatie;
    if (s->semestre == 0 || s->medii_ponderate == NULL || s->credite_semestru == NULL) {
        printf("Studentul nu are inca situatie scolara introdusa.\n");
        return;
    }

    are_date_detaliate = (s->discipline > 0 && s->note != NULL && s->credite != NULL);
    if (are_date_detaliate) {
        calculeaza_indicatori_scolari(s);
    }

    printf("\n=== Raport situatia scolara ===\n");
    printf("Student: %s %s (cod %d)\n", student->nume, student->prenume, student->cod_personal);
    for (sem = 0; sem < s->semestre; sem++) {
        printf(
            "Semestrul %d -> Credite: %d | Medie ponderata: %.2f\n",
            sem + 1,
            s->credite_semestru[sem],
            s->medii_ponderate[sem]
        );
    }

    printf("Discipline cu peste 4 credite: %d\n", s->nr_discipline_peste_4_credite);
    printf("Discipline picate sau absente: %d\n", s->nr_restante_absente);

    if (s->nr_semestre_scadere == 0) {
        printf("Nu exista scaderi de performanta intre semestre consecutive.\n");
    } else {
        printf("Semestre cu scadere de performanta: ");
        for (sem = 0; sem < s->nr_semestre_scadere; sem++) {
            printf("%d ", s->semestre_scadere[sem]);
        }
        printf("\n");
    }

    if (!are_date_detaliate) {
        printf("Detaliul influentei unei singure restante este disponibil dupa salvarea notelor/creditelor pe discipline.\n");
        return;
    }

    for (sem = 0; sem < s->semestre; sem++) {
        restante_sem = 0;
        idx_restanta = -1;
        suma_credite = 0;
        suma_produs = 0;

        for (d = 0; d < s->discipline; d++) {
            if (s->note[sem][d] == -1 || s->credite[sem][d] == -1) {
                continue;
            }
            suma_credite += s->credite[sem][d];
            suma_produs += s->note[sem][d] * s->credite[sem][d];
            if (s->note[sem][d] >= 0 && s->note[sem][d] < 5) {
                restante_sem++;
                idx_restanta = d;
            }
        }

        if (restante_sem == 1 && idx_restanta >= 0) {
            credit_rest = s->credite[sem][idx_restanta];
            punctaj_rest = s->note[sem][idx_restanta] * credit_rest;
            credite_fara = suma_credite - credit_rest;
            medie_fara_restanta = (credite_fara > 0) ? (double)(suma_produs - punctaj_rest) / (double)credite_fara : 0.0;

            printf(
                "Semestrul %d are exact o restanta/absenta. Medie curenta %.2f, medie fara disciplina respectiva %.2f\n",
                sem + 1,
                s->medii_ponderate[sem],
                medie_fara_restanta
            );
        }
    }
}

double media_generala_fara_bonus(const DateStudent *student) {
    int sem;
    double suma = 0.0;
    int count = 0;
    const SituatieStudent *s = &student->situatie;

    if (s->medii_ponderate == NULL || s->semestre == 0) {
        return 0.0;
    }

    for (sem = 0; sem < s->semestre; sem++) {
        if (s->credite_semestru != NULL && s->credite_semestru[sem] > 0) {
            suma += s->medii_ponderate[sem];
            count++;
        }
    }

    return (count > 0) ? (suma / (double)count) : 0.0;
}

double media_generala(const DateStudent *student) {
    double suma = media_generala_fara_bonus(student);
    suma += student->bonus_media;
    if (suma > 10.0) {
        suma = 10.0;
    }
    return suma;
}

void verifica_bonus_media_student(void) {
    int cod;
    DateStudent *student;
    double media_fara_bonus;
    double media_cu_bonus;

    if (nr_studenti == 0) {
        printf("Nu exista studenti inregistrati.\n");
        return;
    }

    printf("Introdu codul personal al studentului (0=Cancel): ");
    fflush(stdout);
    scanf("%d", &cod);
    if (cod == 0) {
        printf("Verificare anulata.\n");
        return;
    }

    student = cauta_student_dupa_cod(cod);
    if (student == NULL) {
        printf("Student inexistent.\n");
        return;
    }

    media_fara_bonus = media_generala_fara_bonus(student);
    media_cu_bonus = media_generala(student);

    printf("\n=== Verificare bonus media ===\n");
    printf("Student: %s %s (cod %d)\n", student->nume, student->prenume, student->cod_personal);
    printf("Media fara bonus: %.2f\n", media_fara_bonus);
    printf("Bonus acumulat: +%.2f\n", student->bonus_media);
    printf("Media finala (cu bonus): %.2f\n", media_cu_bonus);

    if (media_cu_bonus > media_fara_bonus) {
        printf("Verificare: DA, media a crescut.\n");
    } else {
        printf("Verificare: NU, media nu a crescut.\n");
    }
}

void joaca_ruleta_ruseasca(void) {
    int nr_participanti;
    int nr_eligibili;
    int *pool;
    int *participanti;
    int *activ;
    int *eliminati_runda;
    int i;
    int j;
    int temp;
    int activi;
    int runda;
    int eliminati_count;
    int castigator_idx_participant;
    int castigator_idx_student;

    if (nr_studenti == 0) {
        printf("Nu exista studenti inregistrati pentru joc.\n");
        return;
    }

    nr_eligibili = 0;
    for (i = 0; i < nr_studenti; i++) {
        if (studenti[i].bonus_media <= 0.0001) {
            nr_eligibili++;
        }
    }

    if (nr_eligibili == 0) {
        printf("Nu exista studenti eligibili: toti au deja bonus si nu pot intra la ruleta.\n");
        return;
    }

    printf("\n=== Ruleta ruseasca (mod distractie) ===\n");
    printf("Studenti eligibili (fara bonus): %d din %d\n", nr_eligibili, nr_studenti);
    printf("Numar participanti (1..%d, 0=Cancel): ", nr_eligibili);
    fflush(stdout);
    scanf("%d", &nr_participanti);

    if (nr_participanti == 0) {
        printf("Joc anulat. Revenire la meniul principal.\n");
        return;
    }
    if (nr_participanti < 1 || nr_participanti > nr_eligibili) {
        printf("Numar invalid de participanti.\n");
        return;
    }

    pool = (int *)malloc((size_t)nr_eligibili * sizeof(int));
    participanti = (int *)malloc((size_t)nr_participanti * sizeof(int));
    activ = (int *)malloc((size_t)nr_participanti * sizeof(int));
    eliminati_runda = (int *)malloc((size_t)nr_participanti * sizeof(int));
    if (pool == NULL || participanti == NULL || activ == NULL || eliminati_runda == NULL) {
        printf("Eroare: memorie insuficienta pentru joc.\n");
        free(pool);
        free(participanti);
        free(activ);
        free(eliminati_runda);
        return;
    }

    j = 0;
    for (i = 0; i < nr_studenti; i++) {
        if (studenti[i].bonus_media <= 0.0001) {
            pool[j++] = i;
        }
    }

    for (i = nr_eligibili - 1; i > 0; i--) {
        j = rand() % (i + 1);
        temp = pool[i];
        pool[i] = pool[j];
        pool[j] = temp;
    }

    printf("Participanti selectati aleator:\n");
    for (i = 0; i < nr_participanti; i++) {
        participanti[i] = pool[i];
        activ[i] = 1;
        printf(
            "%d. Cod %d | %s %s\n",
            i + 1,
            studenti[participanti[i]].cod_personal,
            studenti[participanti[i]].nume,
            studenti[participanti[i]].prenume
        );
    }

    activi = nr_participanti;
    runda = 1;

    while (activi > 1) {
        eliminati_count = 0;
        printf("\nRunda %d:\n", runda);

        for (i = 0; i < nr_participanti; i++) {
            int glont;
            if (!activ[i]) {
                continue;
            }

            glont = rand() % 6;
            if (glont == 0) {
                activ[i] = 0;
                activi--;
                eliminati_runda[eliminati_count++] = i;
                printf("- %s %s a fost eliminat.\n", studenti[participanti[i]].nume, studenti[participanti[i]].prenume);
            } else {
                printf("- %s %s a supravietuit rundei.\n", studenti[participanti[i]].nume, studenti[participanti[i]].prenume);
            }
        }

        if (activi == 0 && eliminati_count > 0) {
            castigator_idx_participant = eliminati_runda[rand() % eliminati_count];
            activ[castigator_idx_participant] = 1;
            activi = 1;
            printf("Toti au iesit in aceeasi runda; noroc extrem: %s %s revine in joc ca ultim supravietuitor.\n",
                   studenti[participanti[castigator_idx_participant]].nume,
                   studenti[participanti[castigator_idx_participant]].prenume);
            break;
        }

        runda++;
    }

    castigator_idx_participant = -1;
    for (i = 0; i < nr_participanti; i++) {
        if (activ[i]) {
            castigator_idx_participant = i;
            break;
        }
    }

    if (castigator_idx_participant >= 0) {
        castigator_idx_student = participanti[castigator_idx_participant];
        studenti[castigator_idx_student].bonus_media += 0.25;
        scrie_fisa_student(&studenti[castigator_idx_student]);
        printf(
            "\nCastigator: %s %s (cod %d). Bonus acordat: +0.25 la media generala. Media actuala: %.2f\n",
            studenti[castigator_idx_student].nume,
            studenti[castigator_idx_student].prenume,
            studenti[castigator_idx_student].cod_personal,
            media_generala(&studenti[castigator_idx_student])
        );
    } else {
        printf("Nu s-a putut determina un castigator.\n");
    }

    free(pool);
    free(participanti);
    free(activ);
    free(eliminati_runda);
}

void afiseaza_clasament_dupa_medie(void) {
    int i, j;
    int *selectat;
    int best;
    double best_medie;
    double mg;
    if (nr_studenti == 0) {
        printf("Nu exista studenti pentru clasament.\n");
        return;
    }

    for (i = 0; i < nr_studenti; i++) {
        if (studenti[i].situatie.semestre > 0 && studenti[i].situatie.note != NULL && studenti[i].situatie.credite != NULL) {
            calculeaza_indicatori_scolari(&studenti[i].situatie);
        }
    }

    selectat = (int *)calloc((size_t)nr_studenti, sizeof(int));
    if (selectat == NULL) {
        printf("Eroare: memorie insuficienta pentru clasament.\n");
        return;
    }

    printf("\n=== Clasament studenti dupa media generala ===\n");
    for (i = 0; i < nr_studenti; i++) {
        best = -1;
        best_medie = -1.0;
        for (j = 0; j < nr_studenti; j++) {
            if (selectat[j]) {
                continue;
            }
            mg = media_generala(&studenti[j]);
            if (mg > best_medie) {
                best_medie = mg;
                best = j;
            }
        }

        if (best != -1) {
            printf(
                "%d. Cod %d | %s %s | Media generala %.2f\n",
                i + 1,
                studenti[best].cod_personal,
                studenti[best].nume,
                studenti[best].prenume,
                best_medie
            );
            selectat[best] = 1;
        }
    }

    free(selectat);
}

